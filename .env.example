# ============================================================================
# Arthneeti environment variables
#
#   VITE_*      → bundled into the browser JS. Never put secrets here.
#   everything  → read by the ./api serverless functions only.
#
# Locally: copy this file to `.env`. On Vercel: Project Settings →
# Environment Variables. Local `.env` values are NOT auto-synced to Vercel.
# ============================================================================

# ── Firebase web config (REQUIRED) ────────────────────────────────────────
# The app throws on startup if any of these six are missing.
# Firebase console → Project settings → General → Your apps → SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — only enables Analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# ── AI provider chain (server-only) ───────────────────────────────────────
# ./api tries these in order and uses the first one that has a key AND
# answers. At least ONE is required, otherwise /api/news, /api/ai-news and
# /api/ai-digest return 500 "No AI provider is configured".
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# ── Firebase Admin SDK (server-only, OPTIONAL) ────────────────────────────
# Paste the whole service-account JSON on a single line, or base64-encode it.
#
# Leaving this empty is fine for /api: the SDK initialises without a credential
# using VITE_FIREBASE_PROJECT_ID, which is enough to VERIFY user ID tokens —
# that is what /api/* authentication actually needs. What you lose without it
# is the privileged surface: Firestore Admin access, user lookup, and token
# revocation checks. api/leaderboard/snapshot.ts DOES need it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional override for the credential-less fallback above.
FIREBASE_PROJECT_ID=

# Required only by the /api/leaderboard/snapshot cron endpoint.
CRON_SECRET=

# ── Dev server ────────────────────────────────────────────────────────────
# `npm run dev` serves the frontend on 5173 and proxies /api here.
# `npm run dev:api` runs `vercel dev` on 3000, which matches this default.
API_PROXY_TARGET=http://localhost:3000

# Set when hosting under a sub-path, e.g. github.io/arthneeti/
VITE_BASE_PATH=/
