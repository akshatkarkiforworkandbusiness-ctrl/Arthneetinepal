# Firebase Configuration (Required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-side API keys (used in /api/ serverless functions only, NOT exposed to browser)
# Set these in Vercel Project Settings > Environment Variables
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Client-side AI keys (used in frontend only - visible in browser bundle)
# These are optional fallbacks; prefer serverless function proxies
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_CEREBRAS_API_KEY=
VITE_NVIDIA_API_KEY=
VITE_OPENROUTER_API_KEY=

# Optional
VITE_BASE_PATH=/
