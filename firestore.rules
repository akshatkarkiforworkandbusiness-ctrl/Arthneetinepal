rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'topics', 'joinedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'role', 'topics', 'joinedAt', 'schoolId', 'publicPortfolio'])
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.role == 'member'
        && data.topics is list
        && data.name is string && data.name.size() <= 100
        && (!('schoolId' in data) || (data.schoolId is string && data.schoolId.size() <= 100))
        && (!('publicPortfolio' in data) || data.publicPortfolio is bool);
    }

    function isValidProgress(data) {
      return data.keys().hasOnly(['completed', 'quizScores', 'masterExamScores', 'badges', 'updatedAt'])
        && (!('completed' in data) || (data.completed is list && data.completed.size() <= 200))
        && (!('badges' in data) || (data.badges is list && data.badges.size() <= 50
             && data.badges.hasOnly(['First Steps', 'Quiz Whiz', 'Financial Literacy Master', 'Market Maestro'])))
        && (!('quizScores' in data) || data.quizScores is map)
        && (!('masterExamScores' in data) || data.masterExamScores is map)
        && data.updatedAt == request.time;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['type', 'author', 'authorId', 'category', 'content', 'likes', 'commentCount', 'createdAt'])
        && (data.authorId == request.auth.uid || data.authorId == 'system')
        && data.type in ['discussion', 'research', 'question', 'trade-recap', 'news']
        && data.category in ['Finance', 'Economics', 'Business', 'Policy', 'Other']
        && data.likes is int && data.likes >= 0
        && data.commentCount is int && data.commentCount >= 0
        && data.content is string && data.content.size() <= 1000000
        && data.createdAt == request.time
        && (!('title' in data) || (data.title is string && data.title.size() <= 200))
        && (!('abstract' in data) || (data.abstract is string && data.abstract.size() <= 5000))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('pdfUrl' in data) || (data.pdfUrl is string && data.pdfUrl.size() <= 1000));
    }

    function isValidComment(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'text', 'likes', 'createdAt'])
        && data.authorId == request.auth.uid
        && data.text is string && data.text.size() <= 50000
        && data.likes is int && data.likes >= 0
        && data.createdAt == request.time;
    }

    function isValidManuscript(data) {
      return data.keys().hasAll(['name', 'institution', 'email', 'content', 'pdfUrl', 'status', 'submittedAt'])
        && data.name is string && data.name.size() <= 100
        && data.institution is string && data.institution.size() <= 200
        && data.email is string && data.email.size() <= 100
        && data.content is string && data.content.size() <= 1000000
        && data.pdfUrl is string && data.pdfUrl.size() <= 1000
        && data.status == 'pending'
        && data.submittedAt == request.time;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'dateTime', 'location', 'description', 'category', 'createdAt'])
        && data.title is string && data.title.size() <= 200
        && data.location is string && data.location.size() <= 500
        && data.description is string && data.description.size() <= 2000
        && data.category is string
        && data.createdAt == request.time;
    }

    function isValidCertificate(data) {
      return data.keys().hasOnly(['uid', 'name', 'moduleId', 'moduleTitle', 'score', 'completedAt', 'topPerformer'])
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.moduleId is string && data.moduleId.size() <= 100
        && data.moduleTitle is string && data.moduleTitle.size() <= 200
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.completedAt == request.time
        && (!('topPerformer' in data) || data.topPerformer is bool);
    }

    // The canonical Portfolio schema — MUST stay in sync with
    // src/types/trading.ts. `request.resource.data` on an update is the fully
    // merged document, so every key the server writes (unlock/execute) has to
    // appear here or client-side reward/trade writes get rejected forever.
    // The trailing `legacy*` keys are older server shapes kept so existing
    // documents remain writable until api/trading/unlock.ts migrates them.
    function PORTFOLIO_KEYS() {
      return [
        'cashBalance', 'holdings', 'totalValue', 'updatedAt',
        'startingCapital', 'seasonId', 'appliedBonuses', 'dailyTradesCount', 'lastTradeDay',
        'rewardBalance', 'totalRewardsEarned', 'lastLoginDate', 'completedLessons',
        'totalPostsCreated', 'totalLikesGiven',
        'uid', 'cash', 'createdAt', 'lastTradeAt', 'totalTrades', 'schoolId',
        'lastTradeBySymbol'
      ];
    }

    // -------------------------------------------------------------------------
    // RULES
    // -------------------------------------------------------------------------

    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins
    // Read: an admin may check their own doc; everyone else is denied, which is
    // what makes isAdmin() cheap and safe.
    // Create: was `isSignedIn()`, i.e. ANY signed-in user could write
    // `admins/<their-uid>` and grant themselves admin. Now server/manager only.
    match /admins/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming()) && isValidId(userId)
        && incoming().joinedAt == request.time;
      allow update: if isOwner(userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'topics', 'schoolId', 'publicPortfolio'])
        && (existing().joinedAt == incoming().joinedAt)
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().topics is list
        && (!('schoolId' in incoming()) || (incoming().schoolId is string && incoming().schoolId.size() <= 100))
        && (!('publicPortfolio' in incoming()) || incoming().publicPortfolio is bool);

      // Learning progress subcollection
      match /progress/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) && isValidProgress(incoming());
      }

      // Bookmarks subcollection — was undeclared, so the global deny at the
      // bottom of this file blocked it and "Save for later" always failed.
      match /bookmarks/{postId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(postId)
          && incoming().keys().hasOnly(['postId', 'bookmarkedAt'])
          && incoming().postId == postId
          && incoming().bookmarkedAt == request.time;
        // Only `postId`/`bookmarkedAt` may ever change, i.e. nothing.
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // Notifications subcollection — also previously undeclared. The client
      // only reads these and marks them read; creation happens server-side.
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if isAdmin();
        allow update: if isOwner(userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
          && incoming().read is bool;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Posts
    match /posts/{postId} {
      allow read: if true;
      // Seeded/system content (client-side seeding + AI news) must bypass the
      // authorId == request.auth.uid check — that branch is load-bearing — but
      // it must never bypass shape validation: only 'system'/'system-seed'
      // authors, known types/categories, bounded engagement counters, bounded
      // content sizes, and server-set timestamps.
      allow create: if (isVerified() && isValidPost(incoming()))
        || (isAdmin() && isValidPost(incoming()))
        || (isSignedIn() && incoming().seeded == true
          && incoming().authorId in ['system', 'system-seed']
          && incoming().type in ['discussion', 'research', 'question', 'trade-recap', 'news']
          && incoming().category in ['Finance', 'Economics', 'Business', 'Policy', 'Other']
          && incoming().likes is int && incoming().likes >= 0 && incoming().likes <= 100000
          && incoming().commentCount is int && incoming().commentCount >= 0 && incoming().commentCount <= 100000
          && (!('engagementScore' in incoming()) || (incoming().engagementScore is int && incoming().engagementScore >= 0 && incoming().engagementScore <= 100000))
          && incoming().createdAt == request.time
          && incoming().content is string && incoming().content.size() <= 1000000
          && (!('title' in incoming()) || (incoming().title is string && incoming().title.size() <= 200))
          && (!('author' in incoming()) || (incoming().author is string && incoming().author.size() <= 100))
          && (!('abstract' in incoming()) || (incoming().abstract is string && incoming().abstract.size() <= 5000))
          && (!('imageUrl' in incoming()) || (incoming().imageUrl is string && incoming().imageUrl.size() <= 1000))
          && (!('pdfUrl' in incoming()) || (incoming().pdfUrl is string && incoming().pdfUrl.size() <= 1000)));
      // Engagement counters may only move by ±1 and never go negative; nothing
      // in the app sets them to arbitrary values (all writes use increment()).
      allow update: if (isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes'])
          && (incoming().likes == existing().likes + 1 || incoming().likes == existing().likes - 1)
          && incoming().likes >= 0) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['commentCount'])
          && (incoming().commentCount == existing().commentCount + 1 || incoming().commentCount == existing().commentCount - 1)
          && incoming().commentCount >= 0)
      )) || (isOwner(existing().authorId) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'abstract', 'category', 'updatedAt']) && request.time < existing().createdAt + duration.value(24, 'h')) || isAdmin();
      
      allow delete: if (isOwner(existing().authorId) && existing().commentCount == 0) || isAdmin();

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isVerified() && isValidComment(incoming());
        allow update: if (isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['likes'])
          && (incoming().likes == existing().likes + 1 || incoming().likes == existing().likes - 1)
          && incoming().likes >= 0) || isAdmin();
        allow delete: if isAdmin();
      }

      // Likes tracking
      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId) && isValidId(userId);
      }
    }

    // Lesson Comments
    match /lessons/{lessonId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidComment(incoming());
      allow update: if (isSignedIn()
        && incoming().diff(existing()).affectedKeys().hasOnly(['likes'])
        && (incoming().likes == existing().likes + 1 || incoming().likes == existing().likes - 1)
        && incoming().likes >= 0) || isAdmin();
      allow delete: if isAdmin();
    }

    // Events
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin() && isValidEvent(incoming());
      allow update: if isAdmin() && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'dateTime', 'location', 'description', 'category',
          'imageUrl', 'completed', 'studentsReached'
        ])
      );
      allow delete: if isAdmin();
    }

    // Publications
    match /publications/{pubId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Manuscripts (Submissions)
    match /manuscripts/{manId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidManuscript(incoming());
      allow update, delete: if isAdmin();
    }

    // Rigor Content
    match /rigor_content/{rigorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Meta
    match /meta/{docId} {
      allow read: if true;
      // Only the seeding flag may be written by non-admins, and only in the
      // exact shape the app writes it ({ seededAt: serverTimestamp() }).
      allow create, update: if isAdmin() || (isSignedIn() && docId == 'seeded'
        && request.resource.data.keys().hasOnly(['seededAt'])
        && request.resource.data.seededAt == request.time);
      allow delete: if isAdmin();
    }

    // Portfolios
    match /portfolios/{userId} {
      allow read: if isOwner(userId) || (isSignedIn() && get(/databases/$(database)/documents/users/$(userId)).data.publicPortfolio == true);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(PORTFOLIO_KEYS())
        && request.resource.data.cashBalance is number && request.resource.data.cashBalance >= 0;
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(PORTFOLIO_KEYS())
        && request.resource.data.cashBalance is number && request.resource.data.cashBalance >= 0;
      allow delete: if false;

      match /trades/{tradeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['symbol', 'side', 'quantity', 'price', 'total', 'timestamp'])
          && request.resource.data.quantity is number && request.resource.data.quantity > 0;
        allow update, delete: if false; // trade history is append-only
      }
    }

    // Rewards
    match /rewards/{rewardId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Reward Claims
    match /rewardClaims/{claimId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Leaderboards
    match /leaderboards/{snapshotId} {
      allow read: if true;
      allow write: if false;
    }

    // Schools
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Certificates
    match /certificates/{certId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == certId.split('_')[0] && isValidCertificate(incoming());
      allow delete: if isAdmin();
    }

  }
}
